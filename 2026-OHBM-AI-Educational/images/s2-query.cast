[24.29856, "o", "\u001b[?25l\u001b[2D\u001b[3B\r\u001b[2C\u001b[8A-\u001b[5G\"recent\u001b[13Gpapers\u001b[20Gon\u001b[23GX\"\u001b[26G→\u001b[28G\u001b[38;5;153m--year 2023-2025\r\u001b[5C\u001b[1B\u001b[39mhighly\u001b[13Gcit\u001b[17Gd / seminal work on X\" → \u001b[38;5;153m--min-citations 50\u001b[61G\u001b[39m/\u001b[63G\u001b[38;5;153m100\r\u001b[5C\u001b[1B\u001b[39mjust a\u001b[13Gfew\" → \u001b[38;5;153m-n 5\u001b[39m\u001b[K\r\u001b[2B  \u001b[1mWhat I can do with results\u001b[22m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B  - \u001b[1mBrowse\u001b[22m — I just show you the table.\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mAdd to library\u001b[22m — pipe selected papers to your Zotero sync (\u001b[38;5;153m/zotero\u001b[39m).\r\r\n\u001b[3G-\u001b[5G\u001b[1mRefine\u001b[12G\u001b[22m—\u001b[14Gre-run\u001b[21Gwith\u001b[26Gtighter\u001b[34Gfilters\u001b[42Gor\u001b[45Ga\u001b[47Gmodified\u001b[56Gquery.\r\r\n\r\r\n\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────"]
