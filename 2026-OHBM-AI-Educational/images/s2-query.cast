[38.982337, "o", "\u001b[?25l\u001b[3D\u001b[3B\r\u001b[1A\u001b[38;5;153m/s2-query                       Search Semantic Scholar for academic papers. Returns structured results with metadata (title,\u001b[39m\r\r\n\u001b[33G\u001b[38;5;153mauthors,\u001b[42Gyear,\u001b[48Gvenue,\u001b[55GDOI,\u001b[60Gcitation\u001b[69Gcount,\u001b[76Gabstract).\u001b[87GSupports\u001b[96Gyear\u001b[101Grange\u001b[107Gand\u001b[111Gcitation\u001b[120Gcount\u001b[126Gfilter…\u001b[39m\r\r\n\u001b[38;5;246m/curnagl-user\u001b[33GUNIL's\u001b[40GCurnagl\u001b[48GHPC\u001b[52Gsystem\u001b[59G—\u001b[61Gusage\u001b[67Gand\u001b[71Gbest\u001b[76Gpractices.\u001b[87GTrigger\u001b[95Gthis\u001b[100Gskill\u001b[106Gwhenever\u001b[115GCurnagl\u001b[123Gis\u001b[39m\r\r\n\u001b[33G\u001b[38;5;246mmentioned,\u001b[44Gbut\u001b[48Galso\u001b[53Gin\u001b[56GANY\u001b[60Gcontext\u001b[68Gwhere\u001b[74Gheavy\u001b[80Gcomputation\u001b[92Gneeds\u001b[98Gto\u001b[101Grun\u001b[105Gon\u001b[108Gan\u001b[111GHPC/SLURM\u001b[121Gcluster\u001b[129Gand…\u001b[39m\r\r\n\u001b[38;5;246m/init\u001b[33GInitialize\u001b[44Ga\u001b[46Gnew\u001b[50GCLAUDE.md\u001b[60Gfile\u001b[65Gwith\u001b[70Gcodebase\u001b[79Gdocumentation\u001b[39m\r\r\n\u001b[38;5;246m/grant-write\u001b[33GDrafts,\u001b[41Gimproves,\u001b[51Gand\u001b[55Grestructures\u001b[68Ggrant\u001b[74Gapplication\u001b[86Gnarratives,\u001b[98Gand\u001b[102Gupdates\u001b[110Gbudget\u001b[117Gworkbooks.\u001b[128GQuic"]
