[24.409416, "o", "\u001b[?25l\u001b[2D\u001b[3B\r\u001b[2C\u001b[9A-\u001b[5G\u001b[1mBrowse\u001b[12G\u001b[22m—\u001b[14GI\u001b[16Gjust\u001b[21Gshow\u001b[26Gyou\u001b[30Gthe\u001b[34Gtable.\r\u001b[4C\u001b[1B\u001b[1mAdd to library\u001b[22m — pipe selected papers\u001b[43Gto\u001b[46Gyour\u001b[51GZotero\u001b[58Gsync\u001b[63G(\u001b[38;5;153m/zotero\u001b[39m).\r\u001b[4C\u001b[1B\u001b[1mRefine\u001b[22m — re-run with tighter filters or a modified query.\u001b[63G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mPrerequisite:\u001b[17G\u001b[22m\u001b[38;5;153m$SEMANTIC_SCHOLAR_API_KEY\u001b[43G\u001b[39mmust\u001b[48Gbe\u001b[51Gset\u001b[55Gin\u001b[58Gyour\u001b[63Genvironment\u001b[75G(get\u001b[80Ga\u001b[82Gkey\u001b[86G(https://www.semanticscholar.org/product/api)).\r\u001b[1B\u001b[K\r\u001b[1B  ---\r\u001b[1B  Want to run a real search? Just give me the topic — e.g. \u001b[38;5;153m/s2-query LLM code generation neuroimaging --year 2024-2026\u001b[39m — and I'll pull\u001b[K\r\u001b[2C\u001b[1Bthe results.\u001b[K\r\r\n\r\r\n\u001b[38;5;246m✻\u001b[3GSautéed\u001b[11Gfor\u001b[15G13s\u001b[39m\r\r\n\r\r\n\u001b[38;5;244m─────────────────────────────────────────────────────────────────────────"]
