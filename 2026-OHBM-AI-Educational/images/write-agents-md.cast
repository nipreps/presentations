[405.103583, "o", "─────────────────────────\u001b[39m\r\r\n\u001b[3G\u001b[38;5;220m⏵⏵\u001b[6Gauto\u001b[11Gmode\u001b[16Gon\u001b[38;5;246m (shift+tab\u001b[30Gto\u001b[33Gcycle)\u001b[40G·\u001b[42Gesc\u001b[46Gto\u001b[49Ginterrupt\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?25h"]
